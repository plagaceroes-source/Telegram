# --- Telegram userbot (Telethon) ---
# Get these from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Approval / publisher bot (Bot API, from @BotFather) ---
BOT_TOKEN=

# Group chat where a SINGLE approval card is posted (anyone in the group can click
# the buttons). Get the id by adding the bot to the group and checking logs/@getidsbot,
# supergroup ids look like -1001234567890. Leave empty to send individual DMs instead.
APPROVAL_CHAT_ID=

# Telegram user IDs allowed to approve/reject/publish, comma-separated.
# - If APPROVAL_CHAT_ID is set: optional whitelist of who may click buttons in the group
#   (leave empty to allow any group member).
# - If APPROVAL_CHAT_ID is empty: the list of personal chats to DM cards to individually.
APPROVER_CHAT_IDS=

# --- LLM provider for translate/rewrite: "claude" or "gemini" ---
AI_PROVIDER=claude

# --- Claude API (console.anthropic.com) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- Gemini API (aistudio.google.com/apikey) — has a free tier, handy for testing ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Target language posts are rewritten into by default (ru/es/uk/...)
TARGET_LANGUAGE=ru

# --- Database ---
# SQLite for local/dev, Postgres (managed on Render) for production:
# postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./storage/news_agent.db

# --- Storage paths (should point at a persistent disk in production) ---
MEDIA_STORAGE_PATH=./storage/incoming
SESSIONS_PATH=./storage/sessions

# --- Admin panel ---
ADMIN_SECRET_KEY=change-me
ADMIN_PORT=8000

# How often (seconds) the userbot re-polls the sources list from DB.
SOURCES_POLL_INTERVAL=120

# How often (seconds) the processing worker polls raw_posts.
PROCESSING_POLL_INTERVAL=15

# Minimum/maximum pause (seconds) between joining channels during bulk import.
JOIN_PAUSE_MIN=30
JOIN_PAUSE_MAX=120
