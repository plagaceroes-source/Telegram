# --- Telegram userbot (Telethon) ---
# Get these from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Approval / publisher bot (Bot API, from @BotFather) ---
BOT_TOKEN=

# Telegram user IDs allowed to approve/reject/publish drafts, comma-separated.
APPROVER_CHAT_IDS=

# --- Claude API ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Target language posts are rewritten into by default (ru/es/uk/...)
TARGET_LANGUAGE=ru

# --- Database ---
# SQLite for local/dev, Postgres (managed on Render) for production:
# postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./storage/news_agent.db

# --- Storage paths (should point at a persistent disk in production) ---
MEDIA_STORAGE_PATH=./storage/incoming
SESSIONS_PATH=./storage/sessions

# --- Admin panel ---
ADMIN_SECRET_KEY=change-me
ADMIN_PORT=8000

# How often (seconds) the userbot re-polls the sources list from DB.
SOURCES_POLL_INTERVAL=120

# How often (seconds) the processing worker polls raw_posts.
PROCESSING_POLL_INTERVAL=15

# Minimum/maximum pause (seconds) between joining channels during bulk import.
JOIN_PAUSE_MIN=30
JOIN_PAUSE_MAX=120
