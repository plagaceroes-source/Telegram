# --- Telegram ---
BOT_TOKEN=
# Группа модерации (id вида -100123...), бот должен быть в ней
MOD_CHAT_ID=
# Канал проекта, куда бот постит смену слова (необязательно, бот должен быть админом)
CHANNEL_ID=
CHANNEL_URL=https://t.me/your_channel
SUPPORT_USERNAME=your_username

# --- Сайт ---
SITE_URL=http://localhost:8000
DB_PATH=wordsite.db
# на Railway: DB_PATH=/data/wordsite.db и LOGO_DIR=/data/logos (том смонтирован в /data)
LOGO_DIR=

# --- Экономика ---
START_PRICE=1          # EUR: цена первого слова; дальше каждая покупка x2
PAY_WINDOW_SECONDS=300 # 5 минут на оплату после одобрения
MAX_WORD_LEN=30
UAH_RATE=50            # для показа суммы на карту Монобанка

# --- Реквизиты оплаты ---
BIZUM_PHONE=+34 000 000 000
CRYPTO_ADDRESS=
CRYPTO_NETWORK=USDT (TRC20)
MONO_CARD=0000 0000 0000 0000

# --- Реквизиты оператора (для оферты и политики) ---
OPERATOR_NAME=
OPERATOR_EMAIL=

# Оферта скрыта, пока её не проверил юрист. Показать: SHOW_OFFER=1
SHOW_OFFER=0
